# =============================================================================
# Environment Configuration for E2E Tests
# =============================================================================
# Copy this file to .env.local for local development
# These values are also set in GitHub Actions via repository variables/secrets

# Target environment: local | stage | prod
TARGET_ENV=local

# Test suite filter: smoke | regression | (empty for all)
TEST_SUITE=

# Environment URLs
# Local development (used when TARGET_ENV=local)
LOCAL_URL=http://localhost:5173

# Staging environment URL (Vercel preview)
STAGE_URL=https://cron-playwright.vercel.app

# Production environment URL
PROD_URL=https://example.com

# =============================================================================
# CI/CD Configuration
# =============================================================================
# These are typically set automatically in GitHub Actions

# CI indicator (set automatically)
# CI=true

# GitHub run ID (set automatically)
# GITHUB_RUN_ID=

# GitHub SHA (set automatically)
# GITHUB_SHA=
